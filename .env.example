# SOLARIS – Umgebungsvariablen (Vorlage). Kopieren nach .env und Platzhalter ersetzen.
# .env niemals veröffentlichen oder in Git einchecken.

# Pflicht für Verwaltungsfunktionen (Einstellungen, Messpunkte, Backup). Langer Zufallswert:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SOLARIS_ADMIN_TOKEN=<zufaelliger-langer-wert>

# Optional: Long-Lived-Access-Token für die Home-Assistant-REST-Integration (ha_rest)
SOLARIS_HA_TOKEN=<home-assistant-token>

# Optional: Zugangsdaten für einen geschützten MQTT-Broker (in der Integration als username_env/password_env eintragen)
SOLARIS_MQTT_USERNAME=<benutzer>
SOLARIS_MQTT_PASSWORD=<passwort>

# Optional
SOLARIS_LOG_LEVEL=INFO
